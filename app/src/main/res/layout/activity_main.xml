<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:keepScreenOn="true">

    <!-- Top status bar area -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AeroCursor"
            android:textColor="@color/neon_cyan"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <com.google.android.material.chip.Chip
            android:id="@+id/mode_chip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touchpad"
            android:textColor="@color/neon_purple"
            android:checkable="true"
            android:checked="true"
            app:chipIcon="@drawable/ic_touchpad"
            app:chipIconTint="@color/neon_purple"
            app:checkedIcon="@drawable/ic_gyro"
            app:chipBackgroundColor="@color/chip_background" />
    </LinearLayout>

    <!-- Connection status pill -->
    <LinearLayout
        android:id="@+id/status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/header"
        app:layout_constraintTop_toBottomOf="@id/header">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_indicator"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Glass card control zone -->
    <androidx.cardview.widget.CardView
        android:id="@+id/control_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/select_pc_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_pill"
        app:strokeColor="@color/neon_cyan_20"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_background">

            <TextView
                android:id="@+id/control_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="TOUCH TO CLICK"
                android:textColor="#33FFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.2" />

            <LinearLayout
                android:id="@+id/click_labels_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LEFT"
                    android:textColor="#22FFFFFF"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RIGHT"
                    android:textColor="#22FFFFFF"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Select PC button – full width pill -->
    <Button
        android:id="@+id/select_pc_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text="CONNECT TO PC"
        android:textColor="@color/neon_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:background="@drawable/tonal_button_background"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom action row -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/inject_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.2"
            android:text="PASTE CLIPBOARD"
            android:textColor="@color/neon_cyan"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:background="@drawable/tonal_button_background"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/calibrate_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="0.8"
            android:text="CALIBRATE"
            android:textColor="@color/neon_purple"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:background="@drawable/tonal_button_background_purple" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>